# Example Environment Variables
# Copy this file to .env.development or .env.production and fill in the values

# Node Environment
NODE_ENV=production

# Application
APP_NAME=Softensor
APP_URL=https://softensor.com

# Next.js
PORT=3000
HOSTNAME=0.0.0.0

# Nginx
NGINX_PORT=80

# i18n
DEFAULT_LOCALE=es
AVAILABLE_LOCALES=es,en

# Contact Form (optional - for future implementation)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
# El correo de contacto público NO se configura por entorno: es un literal en config/contactChannels.tsx.

# Analytics (optional)
# NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXXXXXX-X
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Feature Flags
# NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Security
# SESSION_SECRET=your-secret-key-here
# API_KEY=your-api-key-here
